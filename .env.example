# Copy to .env and change the passwords before first start.
# These are the ONLY configuration values that live outside the app.
# Everything else (API keys, LLM provider, scanner, FX rates, ...) is set
# through the web UI on the Settings pages and stored in the settings service.

# PostgreSQL superuser password (used only by the db container itself).
POSTGRES_SUPER_PASSWORD=change-me-super

# Per-service database passwords. The db container creates one database and
# one user per service on first start (see infra/postgres-init/).
SETTINGS_DB_PASSWORD=change-me-settings
LEDGER_DB_PASSWORD=change-me-ledger
BUDGET_DB_PASSWORD=change-me-budget
STOCKS_DB_PASSWORD=change-me-stocks
RECEIPTS_DB_PASSWORD=change-me-receipts

# Secret used by web-ui to sign session cookies. Any long random string.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# Host port the web UI is published on (the only published port).
WEBUI_PORT=8000
